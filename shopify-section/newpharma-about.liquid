(()=>{const r=document.querySelector('#np-about-{{ section.id }}');if(!r||r.dataset.ready)return;r.dataset.ready='1';const x=r.querySelectorAll('.np-reveal');if('IntersectionObserver'in window){const o=new IntersectionObserver(e=>e.forEach(a=>{if(a.isIntersecting){a.target.classList.add('is-visible');o.unobserve(a.target)}}),{threshold:.12});x.forEach(e=>o.observe(e))}else x.forEach(e=>e.classList.add('is-visible'));r.querySelectorAll('.np-timeline__item').forEach(e=>{const b=e.querySelector('button');b?.addEventListener('click',()=>{const a=!e.classList.contains('is-open');r.querySelectorAll('.np-timeline__item').forEach(t=>{const n=t===e&&a;t.classList.toggle('is-open',n);t.querySelector('button')?.setAttribute('aria-expanded',String(n));const p=t.querySelector('.np-timeline__panel');if(p)p.hidden=!n})})});const d={part:['01 · Parte utilizada','¿Qué parte del hongo declara la fórmula?','La información debe indicar con claridad la materia prima utilizada y enlazar al respaldo específico de cada producto.'],extract:['02 · Método de extracción','¿Cómo se procesó el ingrediente?','El método debe explicarse de forma comprensible y asociarse al producto concreto.'],components:['03 · Componentes declarados','¿Qué datos respaldan la composición?','Cuando existan análisis o concentraciones declaradas, la página puede mostrarlos y enlazarlos.']},a=r.querySelector('.np-product aside');r.querySelectorAll('.np-tabs button').forEach(b=>b.addEventListener('click',()=>{r.querySelectorAll('.np-tabs button').forEach(c=>c.classList.toggle('is-active',c===b));const v=d[b.dataset.tab];if(a&&v)a.innerHTML=`<small>${v[0]}</small><h3>${v[1]}</h3><p>${v[2]}</p>`}))})();
