{% comment %}NewPharma · Conócenos — sección Shopify Online Store 2.0{% endcomment %}
<section id="np-about-{{ section.id }}" class="np-about" data-np-about>
  <nav class="np-chapters" aria-label="Capítulos"><a href="#np-hero-{{ section.id }}" class="is-active">01</a><a href="#np-story-{{ section.id }}">02</a><a href="#np-pillars-{{ section.id }}">03</a><a href="#np-criteria-{{ section.id }}">04</a><a href="#np-local-{{ section.id }}">05</a><a href="#np-faq-{{ section.id }}">06</a></nav>

  <div id="np-hero-{{ section.id }}" class="np-hero np-observe">
    <div class="np-grid"></div>
    <div class="np-hero__copy np-reveal"><p class="np-kicker"><span></span>{{ section.settings.hero_kicker }}</p><h1>{{ section.settings.hero_title }}</h1><div class="np-lede">{{ section.settings.hero_text }}</div><div class="np-actions"><a class="np-btn np-btn--dark" href="#np-story-{{ section.id }}">{{ section.settings.primary_label }} ↓</a>{% if section.settings.secondary_link != blank %}<a class="np-btn" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }} ↗</a>{% endif %}</div></div>
    <div class="np-hero__stage np-reveal"><div class="np-halo"></div><div class="np-frame"><p>{{ section.settings.hero_note }}</p>{% if section.settings.hero_image != blank %}{% assign hero_alt = section.settings.hero_image.alt | default: 'Producto NewPharma' %}{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '480,720,960,1200', alt: hero_alt }}{% else %}<img src="https://www.newpharma.cl/cdn/shop/files/3COMPLEX_546644db-ae70-432f-99e3-6d5676b742ae.jpg?v=1770661644&width=1445" alt="Producto NewPharma" width="920" height="1100">{% endif %}</div><div class="np-stamp"><strong>2020</strong><span>nuestro punto<br>de partida</span></div></div>
    <div class="np-proof"><article><strong>2020</strong><p>Comienza la historia de NewPharma.</p></article><article><strong>Viña del Mar</strong><p>La ciudad donde nació la marca.</p></article><article><strong>2 años</strong><p>En el Catálogo de Innovación Alimentaria, según NewPharma.</p></article></div>
  </div>

  <div class="np-mission np-observe"><small>Nuestra misión</small><div class="np-reveal"><p class="np-kicker np-kicker--light"><span></span>{{ section.settings.mission_kicker }}</p><h2>{{ section.settings.mission_title }}</h2><div>{{ section.settings.mission_text }}</div></div><svg viewBox="0 0 200 200" aria-hidden="true"><path d="M99 17c2 45-17 71-52 87 37 1 61 16 71 48 4-40 23-68 59-84-39 2-66-15-78-51Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="100" cy="100" r="77" fill="none" stroke="currentColor" opacity=".35"/></svg></div>

  <div id="np-story-{{ section.id }}" class="np-section np-observe"><header class="np-heading np-reveal"><p class="np-kicker"><span></span>Nuestra historia</p><h2>{{ section.settings.story_title }}</h2><p>{{ section.settings.story_intro }}</p></header><div class="np-timeline">{% assign ti = 0 %}{% for block in section.blocks %}{% if block.type == 'timeline' %}{% assign ti = ti | plus: 1 %}<article class="np-timeline__item{% if ti == 1 %} is-open{% endif %}" {{ block.shopify_attributes }}><button type="button" aria-expanded="{% if ti == 1 %}true{% else %}false{% endif %}"><span>0{{ ti }}</span><span><small>{{ block.settings.year }}</small><strong>{{ block.settings.title }}</strong></span><i>+</i></button><div class="np-timeline__panel"{% unless ti == 1 %} hidden{% endunless %}><div>{{ block.settings.text }}</div><figure>{% if block.settings.image != blank %}{% assign ta = block.settings.image.alt | default: block.settings.title %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', alt: ta }}{% else %}<small>{{ block.settings.year }}</small><strong>{{ block.settings.visual_label }}</strong>{% endif %}</figure></div></article>{% endif %}{% endfor %}</div></div>

  <div id="np-pillars-{{ section.id }}" class="np-section np-section--tight np-observe"><header class="np-heading np-reveal"><p class="np-kicker"><span></span>Lo que nos hace únicos</p><h2>{{ section.settings.pillars_title }}</h2><p>{{ section.settings.pillars_intro }}</p></header><div class="np-pillars">{% assign pi = 0 %}{% for block in section.blocks %}{% if block.type == 'pillar' %}{% assign pi = pi | plus: 1 %}<article class="np-reveal" {{ block.shopify_attributes }}><small>0{{ pi }}</small><b>{{ block.settings.symbol }}</b><h3>{{ block.settings.title }}</h3><div>{{ block.settings.text }}</div>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} ↗</a>{% endif %}</article>{% endif %}{% endfor %}</div></div>

  <div id="np-criteria-{{ section.id }}" class="np-criteria np-observe"><div class="np-reveal"><p class="np-kicker np-kicker--light"><span></span>La diferencia NewPharma</p><h2>{{ section.settings.criteria_title }}</h2><p>{{ section.settings.criteria_intro }}</p><div class="np-tabs"><button class="is-active" data-tab="part">01 · Parte utilizada</button><button data-tab="extract">02 · Extracción</button><button data-tab="components">03 · Componentes</button></div></div><div class="np-product np-reveal"><div></div>{% if section.settings.criteria_image != blank %}{% assign ca = section.settings.criteria_image.alt | default: 'Producto de hongos funcionales NewPharma' %}{{ section.settings.criteria_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: ca }}{% else %}<img src="https://www.newpharma.cl/cdn/shop/files/FUNGICOM-2_728e8e2e-940f-4f59-8f76-7a75cba90917_300x.jpg?v=1729620608" alt="Producto de hongos funcionales NewPharma" width="600" height="750" loading="lazy">{% endif %}<aside aria-live="polite"><small>01 · Parte utilizada</small><h3>¿Qué parte del hongo declara la fórmula?</h3><p>La información debe indicar con claridad la materia prima utilizada y enlazar al respaldo específico de cada producto.</p></aside></div></div>

  <div id="np-local-{{ section.id }}" class="np-local np-observe"><div class="np-map np-reveal"><svg viewBox="0 0 320 600" aria-hidden="true"><path d="M184 21c-24 31-11 67-22 97-10 28-40 44-39 82 1 31 28 47 22 78-7 34-41 54-38 91 3 39 41 65 36 104-4 30-33 45-31 78" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/><path d="M184 21c-24 31-11 67-22 97-10 28-40 44-39 82 1 31 28 47 22 78-7 34-41 54-38 91 3 39 41 65 36 104-4 30-33 45-31 78" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".7"/></svg><span><i></i><b>Viña del Mar</b><small>Origen NewPharma</small></span></div><div class="np-local__copy np-reveal"><p class="np-kicker"><span></span>Comercio justo y calidad local</p><h2>{{ section.settings.local_title }}</h2><div>{{ section.settings.local_text }}</div><dl><div><dt>Origen</dt><dd>Viña del Mar, Chile.</dd></div><div><dt>Opciones</dt><dd>Veganas y sin gluten, según cada producto.</dd></div><div><dt>Compromiso</dt><dd>Participación comunicada en Todos Reciclamos.</dd></div></dl>{% if section.settings.stores_link != blank %}<a class="np-btn np-btn--dark" href="{{ section.settings.stores_link }}">{{ section.settings.stores_label }} ↗</a>{% endif %}</div></div>

  <div id="np-faq-{{ section.id }}" class="np-section np-faq np-observe"><header class="np-reveal"><p class="np-kicker"><span></span>Preguntas frecuentes</p><h2>{{ section.settings.faq_title }}</h2><p>{{ section.settings.faq_intro }}</p></header><div class="np-faq__list np-reveal">{% for block in section.blocks %}{% if block.type == 'faq' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span>+</span></summary><div>{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}</div></div>

  <div class="np-cta"><div class="np-reveal"><p class="np-kicker np-kicker--light"><span></span>Continúa explorando</p><h2>{{ section.settings.cta_title }}</h2><p>{{ section.settings.cta_text }}</p><div class="np-actions">{% if section.settings.cta_link != blank %}<a class="np-btn np-btn--lime" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} ↗</a>{% endif %}{% if section.settings.cta_secondary_link != blank %}<a class="np-btn np-btn--light" href="{{ section.settings.cta_secondary_link }}">{{ section.settings.cta_secondary_label }}</a>{% endif %}</div></div><b>NP</b></div>
</section>

{% style %}
#np-about-{{ section.id }}{--g:#6e9e38;--deep:#102b20;--lime:#c8ed59;--cream:#f5f0e5;--paper:#fffdf7;--beige:#e8dccb;--ink:#273128;--muted:#6d756d;--line:rgba(39,49,40,.17);--serif:Georgia,serif;background:var(--cream);color:var(--ink);font-family:Arial,sans-serif;line-height:1.55;overflow:clip}#np-about-{{ section.id }} *{box-sizing:border-box}#np-about-{{ section.id }} img,#np-about-{{ section.id }} svg{display:block;max-width:100%}#np-about-{{ section.id }} a{color:inherit;text-decoration:none}#np-about-{{ section.id }} .np-chapters{position:fixed;z-index:20;top:50%;left:18px;display:flex;flex-direction:column;gap:6px;transform:translateY(-50%)}#np-about-{{ section.id }} .np-chapters a{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:#fffdf7dc;color:var(--muted);font-size:10px}#np-about-{{ section.id }} .np-chapters a.is-active{background:var(--g);color:#fff}#np-about-{{ section.id }} .np-kicker{display:flex;align-items:center;gap:10px;margin:0 0 20px;color:var(--g);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}#np-about-{{ section.id }} .np-kicker span{width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 0 5px #6e9e3828}#np-about-{{ section.id }} .np-kicker--light{color:var(--lime)}#np-about-{{ section.id }} .np-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 23px;border:1px solid var(--line);border-radius:999px;font-size:13px;font-weight:700}#np-about-{{ section.id }} .np-btn--dark{border-color:var(--deep);background:var(--deep);color:#fff}#np-about-{{ section.id }} .np-btn--lime{border-color:var(--lime);background:var(--lime);color:var(--deep)}#np-about-{{ section.id }} .np-btn--light{border-color:#ffffff55;color:#fff}#np-about-{{ section.id }} .np-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}#np-about-{{ section.id }} .np-hero{position:relative;display:grid;grid-template-columns:1.05fr .95fr;grid-template-rows:1fr auto;min-height:820px;padding:130px max(40px,calc((100vw - 1360px)/2)) 40px;background:radial-gradient(circle at 78% 22%,#c8ed5947,transparent 22%),linear-gradient(145deg,#fbf8f0,#ece3d3)}#np-about-{{ section.id }} .np-grid{position:absolute;inset:0;background-image:linear-gradient(#2731280d 1px,transparent 1px),linear-gradient(90deg,#2731280d 1px,transparent 1px);background-size:74px 74px}#np-about-{{ section.id }} .np-hero__copy{position:relative;z-index:2;align-self:center}#np-about-{{ section.id }} h1{margin:0;font:500 clamp(62px,7.6vw,118px)/.88 var(--serif);letter-spacing:-.06em}#np-about-{{ section.id }} h1 em{display:block;color:var(--g)}#np-about-{{ section.id }} .np-lede{max-width:620px;margin-top:30px;color:#536056;font-size:20px}#np-about-{{ section.id }} .np-hero__stage{position:relative;z-index:2;align-self:center;justify-self:end;width:min(100%,520px)}#np-about-{{ section.id }} .np-halo{position:absolute;top:4%;left:0;width:100%;aspect-ratio:1;border:1px solid #25412838;border-radius:50%}#np-about-{{ section.id }} .np-frame{position:relative;z-index:2;overflow:hidden;width:78%;margin-left:auto;aspect-ratio:.74;border-radius:240px 240px 28px 28px;background:linear-gradient(160deg,#d4e49c,#6b9538);box-shadow:0 35px 90px #1b382540;transform:rotate(2deg)}#np-about-{{ section.id }} .np-frame img{width:100%;height:100%;object-fit:cover;mix-blend-mode:multiply}#np-about-{{ section.id }} .np-frame p{position:absolute;z-index:2;top:28px;left:28px;margin:0;font:italic 24px var(--serif);transform:rotate(-4deg)}#np-about-{{ section.id }} .np-stamp{position:absolute;z-index:4;right:-12px;bottom:50px;display:grid;place-items:center;width:142px;aspect-ratio:1;border-radius:50%;background:var(--lime);text-align:center;transform:rotate(9deg)}#np-about-{{ section.id }} .np-stamp strong{font:500 36px var(--serif)}#np-about-{{ section.id }} .np-stamp span{font-size:10px;text-transform:uppercase}#np-about-{{ section.id }} .np-proof{position:relative;z-index:3;grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);margin-top:70px;border-top:1px solid var(--line)}#np-about-{{ section.id }} .np-proof article{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:16px;padding:28px 34px 8px 0;border-right:1px solid var(--line)}#np-about-{{ section.id }} .np-proof article+article{padding-left:34px}#np-about-{{ section.id }} .np-proof strong{font:500 30px var(--serif)}#np-about-{{ section.id }} .np-proof p{margin:0;color:var(--muted);font-size:12px}#np-about-{{ section.id }} .np-mission{display:grid;grid-template-columns:.32fr 1.15fr .45fr;align-items:center;gap:8vw;min-height:620px;padding:100px max(40px,calc((100vw - 1360px)/2));background:var(--g);color:#fff}#np-about-{{ section.id }} .np-mission>small{align-self:start;padding-top:12px;border-top:1px solid #ffffff66;text-transform:uppercase}#np-about-{{ section.id }} .np-mission h2,#np-about-{{ section.id }} .np-heading h2,#np-about-{{ section.id }} .np-faq h2,#np-about-{{ section.id }} .np-local h2{margin:0;font:500 clamp(48px,5.6vw,82px)/.97 var(--serif);letter-spacing:-.05em}#np-about-{{ section.id }} .np-mission svg{color:var(--lime)}#np-about-{{ section.id }} .np-section{width:min(calc(100% - 80px),1360px);margin:auto;padding:125px 0}#np-about-{{ section.id }} .np-section--tight{padding-top:35px}#np-about-{{ section.id }} .np-heading{display:grid;grid-template-columns:.7fr 1.35fr .75fr;align-items:end;gap:6vw;margin-bottom:70px}#np-about-{{ section.id }} .np-heading>p:last-child,#np-about-{{ section.id }} .np-faq header>p:last-child{color:var(--muted)}#np-about-{{ section.id }} .np-timeline{border-top:1px solid var(--line)}#np-about-{{ section.id }} .np-timeline__item{border-bottom:1px solid var(--line)}#np-about-{{ section.id }} .np-timeline__item>button{display:grid;grid-template-columns:80px 1fr auto;align-items:center;width:100%;min-height:126px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}#np-about-{{ section.id }} .np-timeline__item>button>span:first-child{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--line);border-radius:50%;font-size:10px}#np-about-{{ section.id }} .np-timeline__item.is-open>button>span:first-child{background:var(--g);color:#fff}#np-about-{{ section.id }} .np-timeline__item>button>span:nth-child(2){display:flex;align-items:baseline;gap:28px}#np-about-{{ section.id }} .np-timeline__item small{color:#8d6946;text-transform:uppercase}#np-about-{{ section.id }} .np-timeline__item strong{font:500 clamp(28px,3.2vw,45px) var(--serif)}#np-about-{{ section.id }} .np-timeline__item i{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;font-style:normal;font-size:23px}#np-about-{{ section.id }} .np-timeline__item.is-open i{background:var(--lime);transform:rotate(45deg)}#np-about-{{ section.id }} .np-timeline__panel{display:grid;grid-template-columns:1fr 1fr;gap:8vw;padding:4px 0 65px 80px;color:var(--muted)}#np-about-{{ section.id }} .np-timeline__panel figure{display:grid;place-items:center;min-height:260px;margin:0;overflow:hidden;border-radius:20px;background:linear-gradient(145deg,#d7e79e,#83ad53);color:var(--ink)}#np-about-{{ section.id }} .np-timeline__panel figure img{width:100%;height:100%;object-fit:cover}#np-about-{{ section.id }} .np-pillars{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}#np-about-{{ section.id }} .np-pillars article{position:relative;min-height:470px;padding:32px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}#np-about-{{ section.id }} .np-pillars article>b{display:grid;place-items:center;width:86px;height:86px;margin:75px 0 42px;border:1px solid var(--line);border-radius:50%;color:var(--g);font-size:34px}#np-about-{{ section.id }} .np-pillars h3{margin:0;font:500 34px var(--serif)}#np-about-{{ section.id }} .np-pillars article>div{color:var(--