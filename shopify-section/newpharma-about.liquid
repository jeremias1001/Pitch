{% comment %}NewPharma · evolución fiel del HTML guía original{% endcomment %}
<section id="np-about-{{ section.id }}" class="np-about" data-np-about>
  <header class="np-hero">
    <div class="np-hero-media" aria-hidden="true">
      {% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: '' }}{% else %}<img src="https://www.newpharma.cl/cdn/shop/files/3COMPLEX_546644db-ae70-432f-99e3-6d5676b742ae.jpg?v=1770661644&width=1445" alt="" width="920" height="1100">{% endif %}
    </div>
    <div class="np-hero-copy np-reveal"><p class="np-eyebrow">{{ section.settings.hero_eyebrow }}</p><h1>{{ section.settings.hero_title }}</h1><div>{{ section.settings.hero_text }}</div><a href="#np-mission-{{ section.id }}">{{ section.settings.hero_link }} ↓</a></div>
    <small>{{ section.settings.hero_caption }}</small>
  </header>

  <div id="np-mission-{{ section.id }}" class="np-section np-intro np-reveal"><p class="np-label">{{ section.settings.mission_label }}</p><h2>{{ section.settings.mission_title }}</h2><div>{{ section.settings.mission_text }}</div></div>

  <div class="np-section np-history">
    <header class="np-heading np-reveal"><p class="np-label">Nuestra historia</p><h2>{{ section.settings.history_title }}</h2></header>
    <div class="np-timeline">
      {% assign timeline_index = 0 %}{% for block in section.blocks %}{% if block.type == 'timeline' %}{% assign timeline_index = timeline_index | plus: 1 %}
      <article class="np-timeline-item np-reveal{% if timeline_index == 1 %} is-open{% endif %}" {{ block.shopify_attributes }}>
        <button type="button" aria-expanded="{% if timeline_index == 1 %}true{% else %}false{% endif %}"><i></i><span><small>{{ block.settings.year }}</small><strong>{{ block.settings.title }}</strong></span><b>+</b></button>
        <div class="np-timeline-panel"{% unless timeline_index == 1 %} hidden{% endunless %}><div>{{ block.settings.text }}</div><figure>{% if block.settings.image != blank %}{% assign alt = block.settings.image.alt | default: block.settings.title %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: alt }}{% else %}<small>{{ block.settings.year }}</small><strong>{{ block.settings.visual_label }}</strong>{% endif %}</figure></div>
      </article>{% endif %}{% endfor %}
    </div>
  </div>

  <div class="np-section np-pillars">
    <header class="np-center np-reveal"><p class="np-label">Nuestros principios</p><h2>{{ section.settings.pillars_title }}</h2></header>
    <div class="np-pillar-grid">{% assign pillar_index = 0 %}{% for block in section.blocks %}{% if block.type == 'pillar' %}{% assign pillar_index = pillar_index | plus: 1 %}<article class="np-reveal" {{ block.shopify_attributes }}><small>0{{ pillar_index }}</small><b>{{ block.settings.symbol }}</b><h3>{{ block.settings.title }}</h3><div>{{ block.settings.text }}</div></article>{% endif %}{% endfor %}</div>
  </div>

  <div class="np-difference">
    <header class="np-center np-reveal"><p class="np-label">Lo que importa está dentro</p><h2>{{ section.settings.difference_title }}</h2><div>{{ section.settings.difference_intro }}</div></header>
    <div class="np-comparison np-reveal">
      <div class="np-compare"><p><span>✓</span> NewPharma</p><article><b>01</b><h3>{{ section.settings.good_1_title }}</h3><small>{{ section.settings.good_1_text }}</small></article><article><b>02</b><h3>{{ section.settings.good_2_title }}</h3><small>{{ section.settings.good_2_text }}</small></article><article><b>03</b><h3>{{ section.settings.good_3_title }}</h3><small>{{ section.settings.good_3_text }}</small></article></div>
      <div class="np-product"><i></i>{% if section.settings.difference_image != blank %}{% assign alt = section.settings.difference_image.alt | default: 'Producto de hongos funcionales NewPharma' %}{{ section.settings.difference_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: alt }}{% else %}<img src="https://www.newpharma.cl/cdn/shop/files/FUNGICOM-2_728e8e2e-940f-4f59-8f76-7a75cba90917_300x.jpg?v=1729620608" alt="Producto de hongos funcionales NewPharma" width="600" height="750" loading="lazy">{% endif %}<small>{{ section.settings.difference_note }}</small></div>
      <div class="np-compare np-compare-neutral"><p><span>?</span> Cuando la información no es clara</p><article><b>01</b><h3>{{ section.settings.neutral_1_title }}</h3><small>{{ section.settings.neutral_1_text }}</small></article><article><b>02</b><h3>{{ section.settings.neutral_2_title }}</h3><small>{{ section.settings.neutral_2_text }}</small></article><article><b>03</b><h3>{{ section.settings.neutral_3_title }}</h3><small>{{ section.settings.neutral_3_text }}</small></article></div>
    </div>
  </div>

  <div class="np-section np-local"><div class="np-local-copy np-reveal"><p class="np-label">Nuestro origen</p><h2>{{ section.settings.local_title }}</h2><div>{{ section.settings.local_text }}</div><dl><div><dt>Origen</dt><dd>{{ section.settings.local_origin }}</dd></div><div><dt>Alcance</dt><dd>{{ section.settings.local_reach }}</dd></div><div><dt>Compromiso</dt><dd>{{ section.settings.local_commitment }}</dd></div></dl></div><div class="np-map np-reveal"><svg viewBox="0 0 330 620" aria-hidden="true"><path d="M201 22c-23 32-11 67-22 98-10 28-40 44-39 82 1 31 28 47 22 78-7 34-41 54-38 91 3 39 41 65 36 104-4 30-33 45-31 78" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/></svg><span><i></i><strong>Viña del Mar</strong><small>Donde comenzó nuestra historia</small></span></div></div>

  <div class="np-section np-reviews"><header class="np-center np-reveal"><p class="np-label">Comunidad</p><h2>{{ section.settings.reviews_title }}</h2><div>{{ section.settings.reviews_intro }}</div></header><div class="np-review-grid np-reveal"><article><b>★★★★★</b><p>Reseña verificada cargada desde Judge.me.</p><footer>Cliente verificado <small>Producto comprado</small></footer></article><article><b>★★★★★</b><p>Este bloque se reemplaza por el widget dinámico de reseñas al instalar la sección.</p><footer>Integración Judge.me <small>Contenido dinámico</small></footer></article></div></div>
</section>

{% style %}
#np-about-{{ section.id }}{--g:#6e9e38;--gd:#4e6b26;--deep:#16351f;--lime:#c7eb62;--cream:#f6f1e7;--beige:#e9d9c6;--tint:#eee7d6;--paper:#fffdf8;--ink:#3b3a22;--muted:#66705e;--earth:#8a6a45;--line:rgba(59,58,34,.16);background:var(--cream);color:var(--ink);font-family:Arial,sans-serif;line-height:1.65;overflow:clip}#np-about-{{ section.id }} *{box-sizing:border-box}#np-about-{{ section.id }} img,#np-about-{{ section.id }} svg{display:block;max-width:100%}#np-about-{{ section.id }} button{font:inherit}#np-about-{{ section.id }} h1,#np-about-{{ section.id }} h2,#np-about-{{ section.id }} h3{font-family:Georgia,serif;font-weight:500}#np-about-{{ section.id }} .np-section{width:min(calc(100% - 48px),1180px);margin:auto;padding:clamp(78px,9vw,125px) 0}#np-about-{{ section.id }} .np-label{margin:0 0 16px;color:var(--g);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}#np-about-{{ section.id }} .np-hero{position:relative;display:grid;place-items:center;min-height:clamp(560px,72vw,790px);overflow:hidden;padding:70px 24px;background:var(--g);color:#fff;text-align:center}#np-about-{{ section.id }} .np-hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 30%,transparent 18%,#102b1f45 100%),linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:auto,70px 70px,70px 70px}#np-about-{{ section.id }} .np-hero-copy{position:relative;z-index:3;max-width:900px}#np-about-{{ section.id }} .np-eyebrow{margin:0 0 22px;color:#ffffffb8;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}#np-about-{{ section.id }} h1{margin:0;color:#fff;font-size:clamp(56px,8vw,110px);line-height:.92;letter-spacing:-.055em}#np-about-{{ section.id }} .np-hero-copy>div{max-width:650px;margin:25px auto 0;color:#ffffffd1;font-size:clamp(17px,1.8vw,22px)}#np-about-{{ section.id }} .np-hero-copy>a{display:inline-flex;gap:18px;margin-top:32px;padding:13px 22px;border:1px solid #ffffff59;border-radius:999px;color:#fff;text-decoration:none;font-size:13px;font-weight:700}#np-about-{{ section.id }} .np-hero-media{position:absolute;inset:0;z-index:1}#np-about-{{ section.id }} .np-hero-media img{position:absolute;right:5%;bottom:-20%;width:min(31vw,410px);opacity:.24;mix-blend-mode:multiply;transform:rotate(8deg)}#np-about-{{ section.id }} .np-hero>small{position:absolute;z-index:3;bottom:18px;color:#ffffff8c;font-size:10px;letter-spacing:.12em;text-transform:uppercase}#np-about-{{ section.id }} .np-intro,#np-about-{{ section.id }} .np-center{text-align:center}#np-about-{{ section.id }} .np-intro h2,#np-about-{{ section.id }} .np-heading h2,#np-about-{{ section.id }} .np-center h2,#np-about-{{ section.id }} .np-local h2{margin:0;color:var(--gd);font-size:clamp(38px,5vw,64px);line-height:1;letter-spacing:-.04em}#np-about-{{ section.id }} .np-intro>div{max-width:720px;margin:24px auto 0;color:var(--muted);font-size:clamp(17px,1.7vw,20px)}#np-about-{{ section.id }} .np-heading{display:grid;grid-template-columns:.55fr 1.45fr;gap:7vw;margin-bottom:58px}#np-about-{{ section.id }} .np-timeline{position:relative;border-top:1px solid var(--line)}#np-about-{{ section.id }} .np-timeline:before{content:"";position:absolute;top:0;bottom:0;left:25px;width:1px;background:var(--line)}#np-about-{{ section.id }} .np-timeline-item{border-bottom:1px solid var(--line)}#np-about-{{ section.id }} .np-timeline-item>button{display:grid;grid-template-columns:52px 1fr auto;align-items:center;width:100%;min-height:112px;padding:0;border:0;background:transparent;text-align:left;cursor:pointer}#np-about-{{ section.id }} .np-timeline-item>button>i{position:relative;z-index:2;width:13px;height:13px;margin-left:19px;border:3px solid var(--cream);border-radius:50%;background:var(--g);box-shadow:0 0 0 1px var(--g)}#np-about-{{ section.id }} .np-timeline-item>button>span{display:flex;align-items:baseline;gap:30px}#np-about-{{ section.id }} .np-timeline-item>button small{width:95px;color:var(--earth);font-size:12px;font-weight:700}#np-about-{{ section.id }} .np-timeline-item>button strong{color:var(--gd);font-size:clamp(27px,3vw,39px)}#np-about-{{ section.id }} .np-timeline-item>button>b{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--line);border-radius:50%;font-size:21px;transition:.25s}#np-about-{{ section.id }} .np-timeline-item.is-open>button>b{background:var(--lime);transform:rotate(45deg)}#np-about-{{ section.id }} .np-timeline-panel{display:grid;grid-template-columns:1fr .9fr;gap:7vw;padding:0 0 55px 52px}#np-about-{{ section.id }} .np-timeline-panel>div{color:var(--muted);font-size:17px}#np-about-{{ section.id }} .np-timeline-panel figure{display:flex;flex-direction:column;justify-content:flex-end;min-height:240px;margin:0;padding:25px;border-radius:16px;background:linear-gradient(145deg,#d8e7aa,#7daa4f);overflow:hidden}#np-about-{{ section.id }} .np-timeline-panel figure img{width:100%;height:100%;object-fit:cover}#np-about-{{ section.id }} .np-pillars{width:100%;max-width:none;padding-right:max(24px,calc((100vw - 1180px)/2));padding-left:max(24px,calc((100vw - 1180px)/2));background:var(--tint)}#np-about-{{ section.id }} .np-center{max-width:780px;margin:0 auto 52px}#np-about-{{ section.id }} .np-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}#np-about-{{ section.id }} .np-pillar-grid article{min-height:380px;padding:28px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}#np-about-{{ section.id }} .np-pillar-grid article>b{display:grid;place-items:center;width:72px;height:72px;margin:55px 0 32px;border:1px solid var(--line);border-radius:50%;color:var(--g);font-size:30px}#np-about-{{ section.id }} .np-pillar-grid h3{margin:0;color:var(--gd);font-size:29px}#np-about-{{ section.id }} .np-pillar-grid article>div{margin-top:15px;color:var(--muted)}#np-about-{{ section.id }} .np-difference{padding:clamp(85px,10vw,135px) max(24px,calc((100vw - 1180px)/2));background:var(--beige)}#np-about-{{ section.id }} .np-comparison{display:grid;grid-template-columns:1fr minmax(220px,.6fr) 1fr;align-items:center;gap:35px}#np-about-{{ section.id }} .np-compare>p{display:flex;gap:8px;align-items:center;color:var(--gd);font-size:12px;font-weight:700;text-transform:uppercase}#np-about-{{ section.id }} .np-compare>p span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--gd);color:#fff}#np-about-{{ section.id }} .np-compare-neutral>p{color:var(--olive)}#np-about-{{ section.id }} .np-compare article{display:grid;grid-template-columns:32px 1fr;column-gap:13px;padding:18px 0;border-top:1px solid #3b3a221f}#np-about-{{ section.id }} .np-compare article>b{grid-row:1/3;color:var(--earth);font-size:10px}#np-about-{{ section.id }} .np-compare h3{margin:0;font-size:23px}#np-about-{{ section.id }} .np-compare article small{color:var(--muted)}#np-about-{{ section.id }} .np-product{position:relative;display:grid;place-items:center;min-height:500px}#np-about-{{ section.id }} .np-product>i{position:absolute;width:100%;aspect-ratio:1;border:1px solid #4e6b263b;border-radius:50%}#np-about-{{ section.id }} .np-product img{position:relative;z-index:2;width:min(78%,260px);max-height:390px;object-fit:contain}#np-about-{{ section.id }} .np-product>small{position:absolute;bottom:15px;color:var(--muted)}#np-about-{{ section.id }} .np-local{display:grid;grid-template-columns:1fr .85fr;align-items:center;gap:8vw}#np-about-{{ section.id }} .np-local-copy>div{color:var(--muted);font-size:17px}#np-about-{{ section.id }} .np-local dl{margin-top:32px;border-top:1px solid var(--line)}#np-about-{{ section.id }} .np-local dl div{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--line)}#np-about-{{ section.id }} .np-local dd{margin:0;color:var(--muted)}#np-about-{{ section.id }} .np-map{position:relative;display:grid;place-items:center;min-height:560px;border-radius:24px;background:linear-gradient(145deg,#789f4c,#345e38);color:var(--lime)}#np-about-{{ section.id }} .np-map svg{width:250px;height:500px}#np-about-{{ section.id }} .np-map>span{position:absolute;top:225px;left:54%;display:flex;flex-direction:column;padding-left:23px;color:#fff}#np-about-{{ section.id }} .np-map i{position:absolute;top:6px;left:0;width:12px;height:12px;border-radius:50%;background:var(--lime)}#np-about-{{ section.id }} .np-review-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}#np-about-{{ section.id }} .np-review-grid article{min-height:280px;padding:32px;border:1px solid var(--line);border-radius:18px;background:var(--paper)}#np-about-{{ section.id }} .np-review-grid article:last-child{background:var(--gd);color:#fff}#np-about-{{ section.id }} .np-review-grid article>b{color:#e0a83e}#np-about-{{ section.id }} .np-review-grid article>p{margin:40px 0;font:500 clamp(23px,2.7vw,34px)/1.2 Georgia,serif}#np-about-{{ section.id }} .np-review-grid footer{display:flex;justify-content:space-between;padding-top:18px;border-top:1px solid currentColor}#np-about-{{ section.id }} .np-reveal{opacity:0;transform:translateY(22px);transition:.65s}#np-about-{{ section.id }} .np-reveal.is-visible{opacity:1;transform:none}@media(max-width:780px){#np-about-{{ section.id }} .np-section{width:calc(100% - 38px);padding:80px 0}#np-about-{{ section.id }} .np-heading,#np-about-{{ section.id }} .np-pillar-grid,#np-about-{{ section.id }} .np-comparison,#np-about-{{ section.id }} .np-local,#np-about-{{ section.id }} .np-review-grid{grid-template-columns:1fr}#np-about-{{ section.id }} .np-timeline-item>button>span{display:grid;gap:2px}#np-about-{{ section.id }} .np-timeline-item>button small{width:auto}#np-about-{{ section.id }} .np-timeline-panel{grid-template-columns:1fr;padding-left:52px}#np-about-{{ section.id }} .np-product{order:-1;min-height:360px}}
{% endstyle %}

<script>
(() => {const root=document.querySelector('#np-about-{{ section.id }}');if(!root)return;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;const reveal=root.querySelectorAll('.np-reveal');if(reduced||!('IntersectionObserver'in window))reveal.forEach(e=>e.classList.add('is-visible'));else{const o=new IntersectionObserver((entries,obs)=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');obs.unobserve(e.target)}}),{threshold:.12});reveal.forEach(e=>o.observe(e))}const items=root.querySelectorAll('.np-timeline-item');items.forEach(item=>item.querySelector('button')?.addEventListener('click',()=>{const open=!item.classList.contains('is-open');items.forEach(other=>{const active=other===item&&open;other.classList.toggle('is-open',active);other.querySelector('button')?.setAttribute('aria-expanded',String(active));const panel=other.querySelector('.np-timeline-panel');if(panel)panel.hidden=!active})}))})();
</script>

